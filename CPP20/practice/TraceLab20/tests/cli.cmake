cmake_minimum_required(VERSION 3.22)
file(MAKE_DIRECTORY "${OUT}")
set(demo "${SAMPLES}/demo.log")
set(snapshot "${OUT}/统计.tl20")
set(report "${OUT}/report.txt")

function(run expected)
  execute_process(COMMAND "${APP}" ${ARGN} RESULT_VARIABLE code
    OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr ENCODING UTF-8 TIMEOUT 15)
  if(NOT code STREQUAL expected)
    message(FATAL_ERROR "exit ${code}, expected ${expected} for ${ARGN}\n${stdout}\n${stderr}")
  endif()
  string(REPLACE "\r\n" "\n" stdout "${stdout}")
  set(output "${stdout}" PARENT_SCOPE)
  set(errors "${stderr}" PARENT_SCOPE)
endfunction()

run(0 analyze --input "${demo}" --workers 1 --report "${report}" --snapshot "${snapshot}" --progress)
file(READ "${report}" saved)
if(NOT saved STREQUAL output OR NOT errors MATCHES "done=true")
  message(FATAL_ERROR "report or progress mismatch")
endif()
string(REPLACE "${demo}" "<demo>" normalized "${output}")
file(READ "${SAMPLES}/expected_report.txt" golden)
string(REPLACE "\r\n" "\n" golden "${golden}")
if(NOT normalized STREQUAL golden)
  message(FATAL_ERROR "golden report differs:\n${normalized}")
endif()
run(0 show-snapshot "${snapshot}" --timezone Asia/Shanghai)
if(NOT output MATCHES "09:30:00.000000[+]08:00" OR NOT output MATCHES "mean_us=66666.67")
  message(FATAL_ERROR "snapshot time conversion or statistics mismatch")
endif()
run(0 analyze --input "${demo}" --keyword 重试 --component network,policy --min-level warn --flags 3 --top 1)
if(NOT output MATCHES "matched=1" OR NOT output MATCHES "连接重试")
  message(FATAL_ERROR "keyword or filter mismatch")
endif()
run(1 analyze --input "${SAMPLES}/malformed.log")
if(NOT output MATCHES "invalid=1 matched=1" OR NOT output MATCHES "malformed.log:1")
  message(FATAL_ERROR "missing malformed record diagnostic")
endif()
run(2 analyze --input "${SAMPLES}/malformed.log" --strict)
run(2 analyze --input "${demo}" --report "${demo}")
run(2 analyze --input "${demo}" --workers 0)
run(2 analyze --input "${demo}" --timezone TraceLab/Unknown)
file(SHA256 "${snapshot}" before)
run(3 analyze --input "${demo}" --timeout 0ms --snapshot "${snapshot}")
if(NOT output MATCHES "PARTIAL" OR NOT output MATCHES "processed=0")
  message(FATAL_ERROR "cancellation must produce a partial report")
endif()
file(SHA256 "${snapshot}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "cancelled scan replaced snapshot")
endif()
