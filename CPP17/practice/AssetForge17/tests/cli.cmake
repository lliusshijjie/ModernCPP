cmake_minimum_required(VERSION 3.16)
string(RANDOM LENGTH 12 token)
set(work "${OUT}/${token}")
file(MAKE_DIRECTORY "${work}/copy")
file(COPY "${SAMPLES}/art" "${SAMPLES}/scene" "${SAMPLES}/config" DESTINATION "${work}/copy")
file(STRINGS "${SAMPLES}/demo.assets" rows ENCODING UTF-8)
list(REVERSE rows)
list(JOIN rows "\n" reverse)
file(WRITE "${work}/copy/demo.assets" "${reverse}\n")
set(manifest "${SAMPLES}/demo.assets")
set(a "${work}/one.afp")
set(b "${work}/two.afp")
set(c "${work}/shell.afp")

function(expect code)
    execute_process(COMMAND "${APP}" ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr ENCODING UTF-8 TIMEOUT 10)
    if(NOT result STREQUAL code)
        message(FATAL_ERROR "Expected ${code}, got ${result}: ${ARGN}\n${stdout}\n${stderr}")
    endif()
    string(REPLACE "\r\n" "\n" stdout "${stdout}")
    set(out "${stdout}" PARENT_SCOPE)
endfunction()

expect(0 plan "${manifest}" --root startup)
if(NOT out STREQUAL "PLAN 0 ui.logo\nPLAN 1 ui.theme\nPLAN 2 ui.start requires=ui.logo requires=ui.theme\nALIAS startup=ui.start\n")
    message(FATAL_ERROR "Unexpected plan: ${out}")
endif()
expect(0 build "${manifest}" --profile demo --out "${a}" --policy seq --report normalization)
if(NOT out STREQUAL "BUILT assets=3 aliases=1 bytes=26\nnormalized_assets=2 crlf_pairs=2\n")
    message(FATAL_ERROR "Unexpected build: ${out}")
endif()
expect(0 build "${work}/copy/demo.assets" --profile demo --out "${b}" --policy par)
file(SHA256 "${a}" a_hash)
file(SHA256 "${b}" b_hash)
if(NOT a_hash STREQUAL b_hash)
    message(FATAL_ERROR "Artifact changed with reordering, source location, or policy")
endif()

expect(0 verify "${a}" --policy par)
expect(0 inspect "${a}" --id startup --detail)
if(NOT out MATCHES "REQUIRES ui.start ui.logo\nREQUIRES ui.start ui.theme\nALIAS startup=ui.start\nENTRY ui.start offset=15 size=11 crc=")
    message(FATAL_ERROR "Unexpected inspect: ${out}")
endif()
expect(1 inspect "${a}" --id ui.extra)
expect(1 build "${manifest}" --profile demo --out "${a}")
expect(2 plan "${manifest}" --profile demo --root startup)
expect(2 build "${manifest}" --profile demo --out "${work}/no.afp" --report invalid)
if(EXISTS "${work}/no.afp")
    message(FATAL_ERROR "Invalid command published output")
endif()
expect(0 plan "${manifest}" --profile minimal)
if(NOT out STREQUAL "PLAN 0 ui.logo\n")
    message(FATAL_ERROR "Unexpected minimal plan: ${out}")
endif()

file(WRITE "${work}/shell.txt" "rename-alias startup launch\nplan\nbuild --out \"${c}\" --report sizes\nquit\n")
execute_process(COMMAND "${APP}" shell "${manifest}" --profile demo
    INPUT_FILE "${work}/shell.txt" RESULT_VARIABLE code OUTPUT_VARIABLE stdout
    ERROR_VARIABLE stderr ENCODING UTF-8 TIMEOUT 10)
if(NOT code STREQUAL "0" OR NOT stdout MATCHES "ALIAS launch=ui.start" OR NOT stdout MATCHES "size_histogram")
    message(FATAL_ERROR "Unexpected shell result ${code}\n${stdout}\n${stderr}")
endif()
expect(0 inspect "${c}" --id launch)
expect(1 inspect "${c}" --id startup)
